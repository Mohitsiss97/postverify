# ---------- app ----------
ENV=development                 # production me: production
LOG_LEVEL=INFO
LOG_JSON=false                  # production me true — logs machine-readable

# ---------- database ----------
# Dev: SQLite. Production me Postgres zaroor:
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/campaign_portal
DATABASE_URL=sqlite+aiosqlite:///./campaign_portal.db

# ---------- verification engine (postverify-api) ----------
ENGINE_URL=http://localhost:8200
ENGINE_TOKEN=                   # engine pe ACCESS_TOKEN laga ho to wahi yahan
ENGINE_TIMEOUT_SECONDS=120      # Instagram/Facebook pe browser chalta hai

# ---------- rules ----------
SUBMISSION_WINDOW_HOURS=24      # post itne ghante se purani na ho (submit ke waqt se)
MAX_ASSETS_TO_TRY=5             # user ne asset_id na diya ho to itne creatives try honge
                                # (har try ek engine call = Instagram pe ~15s)

# ---------- worker ----------
WORKER_ENABLED=true             # alag process me chalana ho to false + python -m app.worker
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=2
MAX_ATTEMPTS=4                  # sirf takneeki fail pe retry
RETRY_BASE_SECONDS=30

# ---------- storage ----------
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=26214400

# ---------- auth ----------
# Abhi auth nahi hai. ADMIN_TOKEN set kar dijiye to admin endpoints
# (campaign banana, manual approve/reject) uske bina nahi chalenge.
# Production me ye zaroor set kijiye.
ADMIN_TOKEN=
