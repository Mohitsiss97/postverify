# Campaign Portal configuration.
#
# Copy to .env for local work. In production, supply these as real environment
# variables rather than a file, so secrets never sit on disk in the image.
# Anything marked REQUIRED IN PRODUCTION is enforced at startup: the process
# refuses to start without it rather than failing later under load.

# ---------- application ----------
ENV=development                 # development | staging | production
LOG_LEVEL=INFO
LOG_JSON=false                  # true in production, so logs are machine-readable

# ---------- database ----------
# SQLite for development. PostgreSQL is REQUIRED IN PRODUCTION: SQLite
# serialises writes across the whole file, so a second worker fails on lock
# contention.
# DATABASE_URL=postgresql+asyncpg://user:pass@db:5432/campaign_portal
DATABASE_URL=sqlite+aiosqlite:///./campaign_portal.db

# ---------- verification engine (postverify-api) ----------
ENGINE_URL=http://localhost:8200
ENGINE_TOKEN=                   # the engine's ACCESS_TOKEN, if it has one
ENGINE_TIMEOUT_SECONDS=120      # Instagram and Facebook drive a browser

# ---------- verification rules ----------
SUBMISSION_WINDOW_HOURS=24      # maximum post age, measured from submission time
MAX_ASSETS_TO_TRY=5             # creatives tried when asset_id is not supplied;
                                # each attempt is another engine call (~15s on
                                # Instagram)

# ---------- worker ----------
WORKER_ENABLED=true             # false, plus `python -m app.worker`, to run it
                                # as a separate process
WORKER_POLL_SECONDS=2
WORKER_BATCH_SIZE=2
MAX_ATTEMPTS=4                  # retries apply to technical failures only
RETRY_BASE_SECONDS=30

# ---------- storage ----------
# Creatives and verification evidence live here. In production this MUST be a
# persistent volume: on a container restart an ephemeral path takes the
# campaign creatives and the whole audit trail with it.
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=26214400

# ---------- HTTP ----------
# Browser origins allowed to call the API. Empty means same-origin only, which
# is all the bundled UI needs. Never "*": the portal authenticates by header,
# and a wildcard would let any site act on a participant's behalf.
CORS_ORIGINS=
RATE_LIMIT_PER_MINUTE=120       # per client, on write endpoints; 0 disables it
TRUST_PROXY_HEADERS=false       # true only behind a proxy you control, or a
                                # caller can forge X-Forwarded-For and evade
                                # the rate limiter

# ---------- authentication ----------
# There is no user authentication yet; identity arrives in a header.
# ADMIN_TOKEN is REQUIRED IN PRODUCTION. The admin endpoints create campaigns
# and override submission decisions; left open, anyone who can reach the
# service can approve their own submissions.
ADMIN_TOKEN=
