# Kaunsi platform services chalengi. Khali = sab.
PLATFORMS=

# X, LinkedIn  -> kuch nahi chahiye (timestamp ID ke andar hai)
# YouTube      -> kuch nahi chahiye (public page se); key optional
# Instagram    -> Chrome/Edge chahiye (public page browser me render hoti hai); token optional
# Facebook     -> sirf Graph API, token ke bina nahi chalega

# YouTube Data API v3 key. Optional — set karoge to API pehle try hogi.
YOUTUBE_API_KEY=

# Instagram Graph token. Optional — apne account ke posts turant aa jayenge.
IG_ACCESS_TOKEN=

# Facebook Graph token. Iske bina Facebook service chalegi hi nahi.
FB_ACCESS_TOKEN=

# Headless browser tuning
CHROME_PATH=
HEADLESS_MAX_CONCURRENT=4
HEADLESS_TIMEOUT_SEC=45
HEADLESS_WAIT_MS=6000
