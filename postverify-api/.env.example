# PostVerify API configuration.
#
# Copy to .env for local work. In production, supply these as real environment
# variables rather than a file. Anything marked REQUIRED IN PRODUCTION is
# enforced at startup: the process refuses to start without it.

# ---------- deployment ----------
ENV=development                 # development | staging | production
LOG_LEVEL=INFO
JSON_LOGS=                      # defaults to true in production

# ---------- access control ----------
# REQUIRED IN PRODUCTION. Every request here drives a browser and reaches out to
# a social platform. Left open, anyone can generate that traffic from your IP
# address, and the resulting block lands on you.
ACCESS_TOKEN=

# Browser origins allowed to call this API. Empty (the default) means none: it
# is designed to be called server-to-server. Never combine "*" with an access
# token — that hands the token to every site a visitor's browser touches.
CORS_ORIGINS=

# ---------- rate limiting ----------
RATE_LIMIT_PER_MINUTE=60        # per client, on /v1/*; 0 disables it
TRUST_PROXY_HEADERS=false       # true only behind a proxy you control

# ---------- platforms ----------
# Which platforms to enable. Empty means all of them.
# x,instagram,facebook,linkedin,youtube
PLATFORMS=

# ---------- browser ----------
# Instagram, Facebook and LinkedIn image extraction need Chrome or Edge; their
# content never arrives server-side. X and YouTube need no browser at all, so
# PLATFORMS=x,youtube removes the dependency entirely.
CHROME_PATH=
HEADLESS_MAX_CONCURRENT=4       # one Chrome process each; this is the real cap
                                # on throughput, roughly 9-10 renders a minute
HEADLESS_TIMEOUT_SEC=45
HEADLESS_WAIT_MS=6000

# ---------- optional ----------
# When set, YouTube timestamps come from the Data API first, with the public
# page still available as a fallback.
YOUTUBE_API_KEY=
