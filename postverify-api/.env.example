# Kaunse platforms chalein. Khali = sab.
# x,instagram,facebook,linkedin,youtube
PLATFORMS=

# Public deploy pe zaroor set kijiye — warna koi bhi aapke server se
# Instagram/Facebook hit kar sakta hai aur block aapke IP pe aayega.
ACCESS_TOKEN=

# Instagram, Facebook aur LinkedIn(images) ke liye Chrome/Edge chahiye.
# X aur YouTube ko browser ki zaroorat hi nahi.
CHROME_PATH=
HEADLESS_MAX_CONCURRENT=4
HEADLESS_TIMEOUT_SEC=45
HEADLESS_WAIT_MS=6000

# Optional — YouTube ka time Data API se pehle try hoga (page fallback rehta hai)
YOUTUBE_API_KEY=
