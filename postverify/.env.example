# Kaunse platforms chalenge. Khali = sab.
# Comma separated: x,instagram,facebook,linkedin,youtube
PLATFORMS=

# X aur YouTube ko browser ki zaroorat nahi (time offline/page se, images plain HTTP).
# Instagram, Facebook, LinkedIn ke liye Chrome/Edge chahiye.
CHROME_PATH=
HEADLESS_MAX_CONCURRENT=4
HEADLESS_TIMEOUT_SEC=45
HEADLESS_WAIT_MS=6000

# Optional. Set karoge to YouTube ka time Data API se pehle try hoga
# (page fallback rehta hai, to iske bina bhi sab chalta hai).
YOUTUBE_API_KEY=
